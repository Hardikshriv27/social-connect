generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model User {
  id           String             @id @default(uuid())
  email        String             @unique
  name         String?
  passwordHash String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  accounts     ConnectedAccount[]
  posts        Post[]
}

model ConnectedAccount {
  id             String                   @id @default(uuid())
  userId         String
  platform       String                   // "FACEBOOK", "INSTAGRAM", "YOUTUBE", etc.
  platformUserId String                   // ID of the user on that platform
  accessToken    String                   @db.NVarChar(Max) // Store long OAuth tokens safely
  refreshToken   String?                  @db.NVarChar(Max)
  expiresAt      DateTime?
  profileName    String?
  profilePicture String?                  @db.NVarChar(Max)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  user           User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  facebookDetail FacebookAccount?
  instagramDetail InstagramAccount?
  youtubeDetail  YoutubeAccount?
  publishingInfos PlatformPublishingInfo[]

  @@unique([platform, platformUserId])
  @@index([userId])
}

model FacebookAccount {
  id                 String           @id @default(uuid())
  connectedAccountId String           @unique
  pageId             String?
  pageName           String?
  pageAccessToken    String?          @db.NVarChar(Max)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  connectedAccount   ConnectedAccount @relation(fields: [connectedAccountId], references: [id], onDelete: Cascade)
}

model InstagramAccount {
  id                         String           @id @default(uuid())
  connectedAccountId         String           @unique
  instagramBusinessAccountId String?
  username                   String?
  createdAt                  DateTime         @default(now())
  updatedAt                  DateTime         @updatedAt

  connectedAccount           ConnectedAccount @relation(fields: [connectedAccountId], references: [id], onDelete: Cascade)
}

model YoutubeAccount {
  id                 String           @id @default(uuid())
  connectedAccountId String           @unique
  channelId          String?
  channelTitle       String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  connectedAccount   ConnectedAccount @relation(fields: [connectedAccountId], references: [id], onDelete: Cascade)
}

model Post {
  id          String                   @id @default(uuid())
  userId      String
  title       String?
  content     String?                  @db.NVarChar(Max)
  scheduledAt DateTime?
  publishedAt DateTime?
  status      String                   @default("DRAFT") // "DRAFT", "SCHEDULED", "PUBLISHED", "FAILED"
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  user        User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  media       PostMedia[]
  publishingInfos PlatformPublishingInfo[]

  @@index([userId])
}

model PostMedia {
  id        String   @id @default(uuid())
  postId    String
  url       String   @db.NVarChar(Max)
  type      String   // "IMAGE", "VIDEO"
  size      Int?
  mimeType  String?
  createdAt DateTime @default(now())

  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
}

model PlatformPublishingInfo {
  id                 String           @id @default(uuid())
  postId             String
  connectedAccountId String
  status             String           @default("PENDING") // "PENDING", "PUBLISHED", "FAILED"
  externalPostId     String?          // ID of post returned by platform
  errorMessage       String?          @db.NVarChar(Max)
  publishedAt        DateTime?
  platformSpecificData String?        @db.NVarChar(Max) // JSON configurations/options
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  post             Post             @relation(fields: [postId], references: [id], onDelete: Cascade)
  connectedAccount ConnectedAccount @relation(fields: [connectedAccountId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([postId])
  @@index([connectedAccountId])
}
